---
import type { CollectionEntry } from "astro:content";

import "./_styles/main.css";
import Head from "./_components/Head.astro";
import OAuthReturnScript from "./_components/OAuthReturnScript.astro";

export interface Props {
  entry: CollectionEntry<"pages"> | CollectionEntry<"posts"> | CollectionEntry<"projects">;
  rm_classes?: boolean;
}

const { entry, rm_classes = false } = Astro.props;
---

<html
  id="root"
  lang="en"
  class:list={[
    "bg-bg",
    {
      "caret-accent overflow-y-scroll scroll-smooth p-4 sm:pl-8": !rm_classes,
    },
  ]}
>
  <Head {entry} />
  <OAuthReturnScript />
  <body>
    <slot />
  </body>
</html>
